# Frontend Environment Configuration Example
# Copy this file to .env.development.local for local overrides during development.
# NOTE: All VITE_* variables are public to browser users. Never place secrets here.

# Backend API Base URL
# Development: http://localhost:8080 or http://<YOUR_LAN_IP>:8080
# Production: https://pos-api.example-restaurant-pos.com
VITE_API_BASE_URL=http://localhost:8080

# WebSocket Base URL (Optional, defaults to ${VITE_API_BASE_URL}/ws)
# Development: http://localhost:8080/ws or http://<YOUR_LAN_IP>:8080/ws
# Production: https://pos-api.example-restaurant-pos.com/ws
VITE_WS_BASE_URL=http://localhost:8080/ws
